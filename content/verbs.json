{
 "tenses": [
  "pres",
  "ger"
 ],
 "groups": [
  {
   "id": "reg-ar",
   "title": "規則 -ar 動詞",
   "rule": "去掉 -ar，依人稱加 -o、-as、-a、-amos、-áis、-an。例：hablar → hablo、hablas、habla。",
   "src": "ai"
  },
  {
   "id": "reg-er",
   "title": "規則 -er 動詞",
   "rule": "去掉 -er，依人稱加 -o、-es、-e、-emos、-éis、-en。例：comer → como、comes、come。",
   "src": "ai"
  },
  {
   "id": "reg-ir",
   "title": "規則 -ir 動詞",
   "rule": "跟 -er 幾乎一樣，只有 nosotros、vosotros 是 -imos、-ís。例：vivir → vivo、vivimos、vivís。",
   "src": "ai"
  },
  {
   "id": "e-ie",
   "title": "詞根 e 變 ie",
   "rule": "詞根裡的 e 變成 ie，只有 nosotros、vosotros 不變。例：pensar → pienso、piensas、piensa、pensamos。",
   "src": "ai"
  },
  {
   "id": "o-ue",
   "title": "詞根 o 變 ue",
   "rule": "詞根裡的 o 變成 ue，只有 nosotros、vosotros 不變。例：poder → puedo、puedes、puede、podemos。",
   "src": "ai"
  },
  {
   "id": "u-ue",
   "title": "詞根 u 變 ue",
   "rule": "這份清單裡只有 jugar：u 變成 ue，nosotros、vosotros 不變。例：juego、juegas、juega、jugamos。",
   "src": "ai"
  },
  {
   "id": "e-i",
   "title": "詞根 e 變 i",
   "rule": "全是 -ir 動詞：詞根裡的 e 變成 i，nosotros、vosotros 不變。例：pedir → pido、pides、pide、pedimos。",
   "src": "ai"
  },
  {
   "id": "yo-go",
   "title": "yo 加 g（-go）",
   "rule": "yo 的形以 -go 結尾：pongo、salgo 是多一個 g；hago、digo 是 c 換成 g；traigo、oigo 是多了 ig。tener、venir、decir 的其他人稱還有詞根變化；oír 變化最多。",
   "src": "ai"
  },
  {
   "id": "yo-zco",
   "title": "yo 變 -zco",
   "rule": "conocer 這類 -ocer、-ecer 結尾的動詞，yo 變成 -zco：conozco；其他人稱照規則。hacer 不算（它是 hago）。",
   "src": "ai"
  },
  {
   "id": "yo-other",
   "title": "yo 的形特別",
   "rule": "yo 的形不照規則、也不是加 g：sé、veo、doy。其他人稱大多照規則。",
   "src": "ai"
  },
  {
   "id": "irregular",
   "title": "完全不規則",
   "rule": "ser、estar、ir 不照任何一組的規則，整張表直接背起來（表上整格標色，不標個別字母）。",
   "src": "ai"
  }
 ],
