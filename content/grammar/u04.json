{
  "id": "u04",
  "level": "A1",
  "title": "estar：在哪裡、現在怎麼樣",
  "src": "ai",
  "rule": "estar 用來說人或東西「在哪裡」，以及「現在的狀態」（累、忙、好、不好）；ser 說「本來是什麼」（身分、國籍、職業）。",
  "table": [
    [
      "yo estoy",
      "我在／我現在（狀態）"
    ],
    [
      "tú estás",
      "你在／你現在"
    ],
    [
      "él／ella／usted está",
      "他／她／您在"
    ],
    [
      "nosotros estamos",
      "我們在"
    ],
    [
      "vosotros estáis",
      "你們在（西班牙用）"
    ],
    [
      "ellos／ellas／ustedes están",
      "他們／她們／你們在"
    ]
  ],
  "examples": [
    {
      "es": "Estoy en casa.",
      "zh": "我在家。",
      "tatoeba": 1013884
    },
    {
      "es": "Estoy un poco cansado.",
      "zh": "我有點累。",
      "tatoeba": 490274
    },
    {
      "es": "¿Tom está enfermo?",
      "zh": "湯姆生病了嗎？",
      "tatoeba": 2409258
    }
  ],
  "mistake": {
    "wrong": "Soy muy cansado.",
    "why": "累是現在的狀態，不是身分，要用 estar：Estoy muy cansado.",
    "right": "Estoy muy cansado.",
    "tatoeba": 377265
  },
  "notes": [
    "對照：Soy de Taiwán.（我來自臺灣，是身分）／Estoy en Taiwán.（我現在在臺灣，是位置）。",
    "問好用 estar：¿Cómo estás? 回答 Estoy bien.；bien、mal 一律搭 estar。"
  ],
